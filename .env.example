# Copy to .env and fill in. Never commit .env.
# ---- Gateway server ----
# Host/port the gateway listens on
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
# Comma-separated client API keys accepted by the gateway (generate your own random strings)
GATEWAY_API_KEYS=
# debug | info | warning | error
LOG_LEVEL=info

# ---- Redis (cache + rate limiting) ----
REDIS_URL=redis://localhost:6379/0
# Requests per minute allowed per API key
RATE_LIMIT_RPM=60
# Seconds a cached response stays valid
CACHE_TTL_SECONDS=3600
# Cosine similarity threshold for semantic cache hits (0-1)
SEMANTIC_CACHE_THRESHOLD=0.95

# ---- Model backends ----
# Ollama server (https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
# vLLM OpenAI-compatible server (leave blank if not running one)
VLLM_BASE_URL=
# Model used when a request does not specify one
DEFAULT_MODEL=llama3.2
# cost | latency | quality
ROUTING_POLICY=cost
# Per-request upstream timeout and retry count
BACKEND_TIMEOUT_SECONDS=60
BACKEND_MAX_RETRIES=2

# ---- Optional hosted APIs (leave blank to disable) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Observability ----
# OTLP collector endpoint for traces (blank disables export)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=llm-gateway
