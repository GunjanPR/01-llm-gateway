# Copy to .env and fill in. Never commit .env.

# ---- Gateway server ----
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
# Comma-separated client API keys. Requests without one of these get 401.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_API_KEYS=
# debug | info | warning | error
LOG_LEVEL=info
# text | json (one JSON object per line, with request_id, status, latency, model, backend)
LOG_FORMAT=text
# Requests with a larger body get 413 (0 = no limit)
MAX_REQUEST_BYTES=4194304

# Use 127.0.0.1, not "localhost": on Windows "localhost" tries IPv6 (::1) first, and a
# service that only listens on IPv4 (Ollama does) costs ~2 s per new connection.
# The gateway rewrites "localhost" to 127.0.0.1 in the URLs below unless this is false.
PREFER_IPV4_LOOPBACK=true

# ---- Redis (response cache + rate limiting) ----
REDIS_URL=redis://127.0.0.1:6379/0
# Requests per minute per API key (0 disables)
RATE_LIMIT_RPM=60
# all = cache every non-streaming request | deterministic = only temperature=0 or seed set | off
CACHE_MODE=all
CACHE_TTL_SECONDS=3600
# tenant = cached answers only reused for the same API key | global = shared by all keys
CACHE_SCOPE=tenant

# ---- Usage ledger (PostgreSQL) ----
# Password for the postgres container (docker compose); generate one, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
# Gateway on the host -> postgres container. Blank disables the ledger and /v1/usage.
LEDGER_DATABASE_URL=postgresql://llmgw:<POSTGRES_PASSWORD>@127.0.0.1:5432/llmgw
LEDGER_BATCH_SIZE=200
LEDGER_FLUSH_INTERVAL_SECONDS=1.0
LEDGER_MAX_QUEUE=10000

# ---- Semantic cache (needs Redis 8+, which includes vector search) ----
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_EMBED_MODEL=nomic-embed-text
# Model that confirms a candidate needs the same answer; blank disables (not recommended)
SEMANTIC_CACHE_VERIFY_MODEL=llama3.2
# Minimum cosine similarity for a candidate (0-1)
SEMANTIC_CACHE_THRESHOLD=0.86

# ---- Ollama (native install, uses your GPU) ----
# Comma-separate several nodes for failover; they become backends ollama, ollama-2, ...
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Models this backend serves. "public=upstream" maps a gateway name to an Ollama tag.
# "*" accepts any model name.
OLLAMA_MODELS=llama3.2,llama3.2:1b,nomic-embed-text
OLLAMA_QUALITY=0.6

# ---- vLLM (optional; server root, /v1 is added automatically) ----
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_MODELS=*
VLLM_QUALITY=0.6

# ---- Hosted OpenAI-compatible provider (optional fallback) ----
# Example: Groq free tier ->  HOSTED_NAME=groq  HOSTED_BASE_URL=https://api.groq.com/openai/v1
HOSTED_NAME=hosted
HOSTED_BASE_URL=
HOSTED_API_KEY=
# Map gateway model names to the provider's names, e.g. llama3.2=llama-3.1-8b-instant
HOSTED_MODELS=
# USD per 1K tokens, used for cost tracking
HOSTED_COST_PER_1K_INPUT=0
HOSTED_COST_PER_1K_OUTPUT=0
HOSTED_QUALITY=0.8

# ---- Guardrails ----
# PII in prompts: off | redact (replace with [REDACTED_<KIND>]) | block (reject with 400)
GUARDRAIL_PII=redact
# PII in model answers, streamed or not: off | redact
GUARDRAIL_OUTPUT_PII=redact
# Prompt injection in user/tool messages: off | flag (header + metric) | block (reject with 400)
GUARDRAIL_INJECTION=flag

# ---- Tracing (OpenTelemetry, OTLP/HTTP) ----
# Jaeger from docker compose; blank disables tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=llm-gateway

# ---- Routing ----
# Model used when a request does not name one
DEFAULT_MODEL=llama3.2
# cost | latency | quality
ROUTING_POLICY=cost
BACKEND_TIMEOUT_SECONDS=60
# Retries per backend before falling back to the next one
BACKEND_MAX_RETRIES=1
RETRY_BACKOFF_SECONDS=0.2
# Consecutive failures that open a backend's circuit breaker, and how long it stays open
CIRCUIT_BREAKER_FAILURES=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
# Load shedding: max concurrent calls per backend (0 = unlimited). A full backend spills
# over to the next one; when all are full, requests wait up to the queue timeout, then get
# 503 + Retry-After. For Ollama, about 2x OLLAMA_NUM_PARALLEL works well.
BACKEND_MAX_CONCURRENCY=8
BACKEND_QUEUE_TIMEOUT_SECONDS=30
# Cancel the backend call (stop generating) when the client disconnects
CANCEL_ON_DISCONNECT=true
# Background probes of Redis and backends; feeds llmgw_backend_reachable (0 disables)
HEALTH_CHECK_INTERVAL_SECONDS=15
# Backend HTTP client: aiohttp (about half the CPU per call) | httpx
BACKEND_HTTP_TRANSPORT=aiohttp
# Idle backend connections are kept this long, so pauses don't force new TCP connects
BACKEND_KEEPALIVE_SECONDS=60
BACKEND_MAX_CONNECTIONS=100
# Connect to Redis and every backend at startup
WARM_UP_CONNECTIONS=true

# ---- Docker Compose only ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Integration tests: one of GATEWAY_API_KEYS
GATEWAY_TEST_KEY=
